{
  "name": "hakanai-bundler",
  "version": "1.0.0",
  "description": "Build tools for Hakanai TypeScript bundling",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c && npm run build:css",
    "build:watch": "rollup -c -w",
    "build:css": "csso ../server/includes/style.css -o ../server/includes/style.min.css",
    "test": "cd tests && npm test",
    "test:install": "cd tests && npm install"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "csso-cli": "^4.0.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^31.0.0",
    "rollup": "^4.68.0",
    "ts-jest": "^29.4.15",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "web-streams-polyfill": "^4.5.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
